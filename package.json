{
  "name": "cave-et-amis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cave & Amis — votre cave, vos amis, la bonne bouteille au bon moment.",
  "scripts": {
    "local": "node scripts/local.mjs",
    "local:server": "node --disable-warning=ExperimentalWarning server/local/main.ts",
    "dev": "vite --host",
    "build": "tsc -b && vite build --emptyOutDir && node scripts/check-dist.mjs dist",
    "build:function": "node scripts/build-function.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs",
    "verify": "node scripts/verify.mjs",
    "package:site": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-site.ps1"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "1.58.0",
    "onnxruntime-web": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
