# En-têtes de sécurité (Netlify et Cloudflare Pages lisent ce fichier).
# La politique de sécurité (CSP) est construite à l'export par vite.config.ts, d'après la configuration (adresse du
# projet Supabase, clé Turnstile) : la ligne Content-Security-Policy est remplacée dans dist/_headers.
/*
  Content-Security-Policy: construite à l'export (vite.config.ts)
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

/index.html
  Cache-Control: no-cache

/config.js
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
